<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BrightnessControl.App.Views.BrightnessHudWindow"
        WindowDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Background="#CC202020">
    <!-- Три альтернативных представления HUD (FP12 Фаза 4, п.6) собраны в
         одном Grid и переключаются через IsVisible в code-behind — какое
         показывать, решает TraySettings.HudStyleId. Размер самого окна
         тоже пересчитывается под выбранный стиль перед каждым показом. -->
    <Grid x:Name="RootGrid" />
</Window>
