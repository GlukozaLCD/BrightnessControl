<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BrightnessControl.App.Views.SettingsWindow"
        Title="BrightnessControl — Настройки"
        Width="520" Height="560"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True">
    <Border BorderBrush="#40808080" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="32" ColumnDefinitions="*,Auto">
                <Border x:Name="CloseButton"
                        Grid.Column="1"
                        Width="46" Height="32">
                    <TextBlock x:Name="CloseButtonGlyph"
                               Text="✕"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
            <TabControl>
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="MinHeight" Value="28" />
                    </Style>
                </TabControl.Styles>
                <TabItem Header="Мониторы">
                    <ScrollViewer>
                        <StackPanel x:Name="MonitorsPanel" Margin="16" Spacing="8" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Трей">
                    <ScrollViewer>
                        <StackPanel x:Name="TrayPanel" Margin="16" Spacing="8" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Оформление">
                    <ScrollViewer>
                        <StackPanel x:Name="AppearancePanel" Margin="16" Spacing="8" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Расписание">
                    <ScrollViewer>
                        <StackPanel x:Name="SchedulePanel" Margin="16" Spacing="8" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Профили приложений">
                    <ScrollViewer>
                        <StackPanel x:Name="AppProfilesPanel" Margin="16" Spacing="8" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Простой">
                    <ScrollViewer>
                        <StackPanel x:Name="IdlePanel" Margin="16" Spacing="8" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
