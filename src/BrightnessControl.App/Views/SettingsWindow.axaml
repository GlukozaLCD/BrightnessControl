<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BrightnessControl.App.Views.SettingsWindow"
        Title="BrightnessControl — Настройки"
        Width="760" Height="560"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True">
    <Border BorderBrush="#40808080" BorderThickness="1" Background="{DynamicResource AppWindowBackground}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="32" ColumnDefinitions="*,Auto">
                <Border x:Name="CloseButton"
                        Grid.Column="1"
                        Width="46" Height="32">
                    <TextBlock x:Name="CloseButtonGlyph"
                               Text="✕"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
            <!-- Тонкая акцентная полоска на всю ширину окна сразу под заголовком —
                 по образцу Volumey; теперь основной способ показать акцент вместо
                 рамки вокруг сайдбара (её убрали, см. NavBorder ниже). -->
            <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource AppAccentBrush}" />
            <Grid x:Name="NavContentGrid" ColumnDefinitions="*,Auto">
                <ScrollViewer Grid.Column="0">
                    <StackPanel x:Name="ContentPanel" Margin="16" Spacing="8" />
                </ScrollViewer>
                <Border x:Name="NavBorder"
                        Grid.Column="1"
                        Width="170"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <DockPanel>
                        <Button x:Name="NavFlipButton"
                                DockPanel.Dock="Top"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        <StackPanel x:Name="NavList" Margin="6" Spacing="4" />
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
